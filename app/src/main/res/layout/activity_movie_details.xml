<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg"
    tools:context=".activities.MovieDetailsActivity">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tv_movie_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="Movie Name"
            android:textColor="@color/white"
            android:textSize="22sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="24dp">

                <ImageView
                    android:id="@+id/iv_movie_cover"
                    android:layout_width="160dp"
                    android:layout_height="220dp"
                    android:layout_margin="16dp"
                    android:scaleType="fitXY"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_launcher_background" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Genre:"
                    android:textColor="@color/colorPrimary"
                    app:layout_constraintStart_toEndOf="@id/iv_movie_cover"
                    app:layout_constraintTop_toTopOf="@id/iv_movie_cover" />

                <TextView
                    android:id="@+id/tv_genre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:text="abc"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toEndOf="@id/textView"
                    app:layout_constraintTop_toTopOf="@id/iv_movie_cover"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Casting:"
                    android:textColor="@color/colorPrimary"
                    app:layout_constraintStart_toEndOf="@id/iv_movie_cover"
                    app:layout_constraintTop_toBottomOf="@id/textView" />

                <TextView
                    android:id="@+id/tv_casting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="abc"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toEndOf="@id/iv_movie_cover"
                    app:layout_constraintTop_toBottomOf="@id/textView1"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Description:"
                    android:textColor="@color/colorPrimary"
                    app:layout_constraintStart_toEndOf="@id/iv_movie_cover"
                    app:layout_constraintTop_toBottomOf="@id/tv_casting" />

                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="abc"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toEndOf="@id/iv_movie_cover"
                    app:layout_constraintTop_toBottomOf="@id/textView2"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <RatingBar
                    android:id="@+id/ratingBar"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:max="5"
                    android:theme="@style/RatingBar"
                    app:layout_constraintStart_toStartOf="@+id/iv_movie_cover"
                    app:layout_constraintTop_toBottomOf="@id/iv_movie_cover" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Duration: "
                    android:textColor="@color/colorPrimary"
                    app:layout_constraintStart_toStartOf="@id/iv_movie_cover"
                    app:layout_constraintTop_toBottomOf="@id/ratingBar" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:text="abc"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toEndOf="@id/textView3"
                    app:layout_constraintTop_toBottomOf="@id/ratingBar" />

                <Button
                    android:id="@+id/btn_play_movie"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/button_stroke"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Play"
                    android:textAllCaps="false"
                    android:textColor="#FFFEFE"
                    app:layout_constraintStart_toStartOf="@id/iv_movie_cover"
                    app:layout_constraintTop_toBottomOf="@id/textView3"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:indeterminateTint="@color/purple_200"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>